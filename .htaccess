# MADARI — server rules (Hostinger / LiteSpeed-Apache)

Options -Indexes
ErrorDocument 404 /404.html

# Repository files are not part of the website
<FilesMatch "\.(md|ps1|log|gitignore|sql|json|lock)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Backend code and SQL are never served directly
  RewriteRule ^(lib|supabase|vendor)(/|$) - [F,L]
  # WhatsApp Cloud API webhook
  RewriteRule ^api/whatsapp/webhook/?$ api/whatsapp/webhook.php [L,QSA]
</IfModule>

AddType font/ttf .ttf
AddType image/webp .webp
AddType image/svg+xml .svg

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=15552000"

  # pages: always revalidate so new deployments show immediately
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # versioned CSS/JS (?v=N): cache long
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  # images & fonts: one month
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ttf|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
